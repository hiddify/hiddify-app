// Debug supports local development without restricted Apple entitlements.
HIDDIFY_NETWORK_EXTENSION_ENABLED = YES
HIDDIFY_NETWORK_EXTENSION_ENABLED[config=Debug] = NO
HIDDIFY_HOST_ENTITLEMENTS = Runner/Release.entitlements
HIDDIFY_HOST_ENTITLEMENTS[config=Debug] = Runner/Developer.entitlements
HIDDIFY_EXTENSION_CODE_SIGN_ALLOWED = YES
HIDDIFY_EXTENSION_CODE_SIGN_ALLOWED[config=Debug] = NO
HIDDIFY_TUNNEL_BUNDLE_IDENTIFIER = app.hiddify.com.HiddifyPacketTunnel
HIDDIFY_APP_BUNDLE_IDENTIFIER = app.hiddify.com
HIDDIFY_VPN_APP_GROUP = $(TeamIdentifierPrefix)app.hiddify.com.vpn
// Apple Development profiles use the standard value; Developer ID uses the suffix.
HIDDIFY_NETWORK_EXTENSION_ENTITLEMENT = packet-tunnel-provider-systemextension
HIDDIFY_NETWORK_EXTENSION_ENTITLEMENT[config=Debug] = packet-tunnel-provider
HIDDIFY_LOCAL_NETWORK_EXTENSION_BUILD = NO
MACOSX_DEPLOYMENT_TARGET = 12.0

// Optional machine-specific team/signing overrides; see NETWORK_EXTENSION.md.
#include? "NetworkExtension.local.xcconfig"
